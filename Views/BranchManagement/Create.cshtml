@using CompanyApi.DTOs.BranchDtos
@model CreateBranchDto

@{
    ViewData["Title"] = "إنشاء فرع جديد";
    Layout = "_Layout";
}

<div class="p-6" dir="rtl">
    <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <div class="mb-6">
                <h1 class="text-2xl font-bold text-gray-900 mb-2">إنشاء فرع جديد</h1>
                <p class="text-gray-600">إضافة موقع فرع جديد إلى النظام.</p>
            </div>

            <form asp-action="Create" method="post">
                <div class="mb-4">
                    <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-2">اسم الفرع</label>
                    <input asp-for="Name"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                        required />
                    <span asp-validation-for="Name" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Code" class="block text-sm font-medium text-gray-700 mb-2">رمز الفرع</label>
                    <input asp-for="Code"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                        required />
                    <span asp-validation-for="Code" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label asp-for="Country" class="block text-sm font-medium text-gray-700 mb-2">البلد</label>
                        <input asp-for="Country"
                            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                            required />
                        <span asp-validation-for="Country" class="text-red-500 text-sm mt-1"></span>
                    </div>

                    <div>
                        <label asp-for="Governate" class="block text-sm font-medium text-gray-700 mb-2">المحافظة</label>
                        <input asp-for="Governate"
                            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                            required />
                        <span asp-validation-for="Governate" class="text-red-500 text-sm mt-1"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="RegionCity"
                        class="block text-sm font-medium text-gray-700 mb-2">المنطقة/المدينة</label>
                    <input asp-for="RegionCity"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"
                        required />
                    <span asp-validation-for="RegionCity" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Street" class="block text-sm font-medium text-gray-700 mb-2">الشارع</label>
                    <input asp-for="Street"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" />
                    <span asp-validation-for="Street" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="BuildingNumber" class="block text-sm font-medium text-gray-700 mb-2">رقم
                        المبنى</label>
                    <input asp-for="BuildingNumber"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" />
                    <span asp-validation-for="BuildingNumber" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div class="mb-4">
                    <div class="flex items-center">
                        <input asp-for="IsActive" type="checkbox"
                            class="h-4 w-4 text-primary focus:ring-primary border-gray-300 rounded" />
                        <label asp-for="IsActive" class="mr-2 block text-sm text-gray-900">نشط</label>
                    </div>
                    <span asp-validation-for="IsActive" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div class="flex justify-between items-center pt-6">
                    <a href="@Url.Action("Index", "BranchManagement")"
                        class="px-4 py-2 text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                        <i class="fas fa-arrow-right ml-2"></i>العودة للقائمة
                    </a>
                    <button type="submit"
                        class="px-6 py-2 bg-primary text-white rounded-lg hover:bg-blue-700 transition-colors">
                        <i class="fas fa-save ml-2"></i>إنشاء الفرع
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}