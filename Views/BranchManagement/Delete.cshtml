@using CompanyApi.DTOs.BranchDtos
@model BranchDto

@{
    ViewData["Title"] = "حذف الفرع";
    Layout = "_Layout";
}

<div class="p-6" dir="rtl">
    <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <div class="mb-6">
                <h1 class="text-2xl font-bold text-gray-900 mb-2">حذف الفرع</h1>
                <p class="text-gray-600">هل أنت متأكد من حذف هذا الفرع؟ لا يمكن التراجع عن هذا الإجراء.</p>
            </div>

            <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
                <div class="flex items-start">
                    <div class="bg-red-100 rounded-full p-2 ml-3">
                        <i class="fas fa-exclamation-triangle text-red-600"></i>
                    </div>
                    <div>
                        <h3 class="font-medium text-red-900 mb-1">تحذير</h3>
                        <p class="text-red-700 text-sm">سيتم حذف هذا الفرع بشكل دائم من النظام. لا يمكن التراجع عن هذا الإجراء.</p>
                    </div>
                </div>
            </div>

            <div class="bg-gray-50 rounded-lg p-4 mb-6">
                <h3 class="font-medium text-gray-900 mb-3">معلومات الفرع</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">اسم الفرع</label>
                        <p class="text-gray-900">@Model.Name</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">رمز الفرع</label>
                        <p class="text-gray-900">@Model.Code</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">البلد</label>
                        <p class="text-gray-900">@Model.Country</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">المحافظة</label>
                        <p class="text-gray-900">@Model.Governate</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">المنطقة/المدينة</label>
                        <p class="text-gray-900">@Model.RegionCity</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">الحالة</label>
                        <p class="text-gray-900">@(Model.IsActive ? "نشط" : "غير نشط")</p>
                    </div>
                </div>
            </div>

            <form asp-action="DeleteConfirmed" method="post" class="flex justify-between items-center">
                <input type="hidden" asp-for="Id" />
                <a href="@Url.Action("Index", "BranchManagement")" class="px-4 py-2 text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                    <i class="fas fa-arrow-right mr-2"></i>إلغاء
                </a>
                <button type="submit" class="px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">
                    <i class="fas fa-trash mr-2"></i>حذف الفرع
                </button>
            </form>
        </div>
    </div>
</div>
