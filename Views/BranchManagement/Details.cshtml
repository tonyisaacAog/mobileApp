@model CompanyApi.DTOs.BranchDto

@{
    ViewData["Title"] = "Branch Details";
    Layout = "_Layout";
}

<div class="p-6">
    <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <div class="flex justify-between items-start mb-6">
                <div>
                    <h1 class="text-2xl font-bold text-gray-900 mb-2">Branch Details</h1>
                    <p class="text-gray-600">View branch information and location details.</p>
                </div>
                <div class="flex space-x-2">
                    <a href="@Url.Action("Edit", "BranchManagement", new { id = Model.Id })"
                       class="px-4 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 transition-colors">
                        <i class="fas fa-edit mr-2"></i>Edit
                    </a>
                    <a href="@Url.Action("Index", "BranchManagement")"
                       class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors">
                        <i class="fas fa-arrow-left mr-2"></i>Back to List
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Branch Name</label>
                        <p class="text-gray-900 bg-gray-50 px-3 py-2 rounded-lg">@Model.Name</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Branch Code</label>
                        <p class="text-gray-900 bg-gray-50 px-3 py-2 rounded-lg">@Model.Code</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Country</label>
                        <p class="text-gray-900 bg-gray-50 px-3 py-2 rounded-lg">@Model.Country</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Governorate</label>
                        <p class="text-gray-900 bg-gray-50 px-3 py-2 rounded-lg">@Model.Governate</p>
                    </div>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Region/City</label>
                        <p class="text-gray-900 bg-gray-50 px-3 py-2 rounded-lg">@Model.RegionCity</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Street</label>
                        <p class="text-gray-900 bg-gray-50 px-3 py-2 rounded-lg">@(string.IsNullOrEmpty(Model.Street) ? "Not specified" : Model.Street)</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Building Number</label>
                        <p class="text-gray-900 bg-gray-50 px-3 py-2 rounded-lg">@(string.IsNullOrEmpty(Model.BuildingNumber) ? "Not specified" : Model.BuildingNumber)</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @(Model.IsActive ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800")">
                            @(Model.IsActive ? "Active" : "Inactive")
                        </span>
                </div>
            </div>

            <div class="mt-8 pt-6 border-t border-gray-200">
                <div class="flex justify-between items-center">
                    <div class="text-sm text-gray-500">@Model.Governate, @Model.RegionCity</div>
                    <span class="text-sm text-gray-500">
                        Branch ID: @Model.Id
                    </span>
                    <button onclick="confirmDelete(@Model.Id, '@Model.Name')"
                            class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">
                        <i class="fas fa-trash mr-2"></i>Delete Branch
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function confirmDelete(id, name) {
    if (confirm(`Are you sure you want to delete the branch "${name}"? This action cannot be undone.`)) {
        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '@Url.Action("Delete", "BranchManagement")/' + id;

        var token = document.createElement('input');
        token.type = 'hidden';
        token.name = '__RequestVerificationToken';
        token.value = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        form.appendChild(token);

        document.body.appendChild(form);
        form.submit();
    }
}
</script>
