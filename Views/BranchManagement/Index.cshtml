@using CompanyApi.DTOs.BranchDtos
@model List<BranchDto>

@{
    ViewData["Title"] = "إدارة الفروع";
    Layout = "_Layout";
}

<div class="p-6" dir="rtl">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">إدارة الفروع</h1>
            <p class="text-gray-600 mt-1">إدارة فروع الشركة ومواقعها</p>
        </div>
        <a href="@Url.Action("Create","BranchManagement")"
           class="inline-flex items-center px-4 py-2 bg-primary text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
            <i class="fas fa-plus mr-2"></i>
            إضافة فرع
        </a>
    </div>

    <!-- الجدول -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        @if( Model != null && Model.Count > 0 )
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                                تفاصيل الفرع
                            </th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                                الموقع
                            </th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                                الحالة
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                الإجراءات
                            </th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach( var branch in Model )
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <!-- تفاصيل الفرع -->
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center">
                                        <div class="bg-blue-100 rounded-full p-2 ml-3">
                                            <i class="fas fa-code-branch text-blue-600"></i>
                                        </div>
                                        <div>
                                            <div class="text-sm font-medium text-gray-900">@branch.Name</div>
                                            <div class="text-sm text-gray-500">@branch.Code</div>
                                        </div>
                                    </div>
                                </td>

                                <!-- الموقع -->
                                <td class="px-6 py-4">
                                    <div class="text-sm text-gray-900">@branch.Country</div>
                                    <div class="text-sm text-gray-500">@branch.Governate، @branch.RegionCity</div>
                                    @if( !string.IsNullOrEmpty(branch.Street) )
                                    {
                                        <div class="text-sm text-gray-500">@branch.Street @branch.BuildingNumber</div>
                                    }
                                </td>

                                <!-- الحالة -->
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if( branch.IsActive )
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                            <i class="fas fa-check-circle mr-1"></i> نشط
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                            <i class="fas fa-pause-circle mr-1"></i> غير نشط
                                        </span>
                                    }
                                </td>

                                <!-- Actions -->
                                <td class="px-6 py-4 whitespace-nowrap text-left text-sm font-medium">
                                    <div class="flex items-center justify-start space-x-3 rtl:space-x-reverse">
                                        <a href="@Url.Action("Details", "BranchManagement", new { id = branch.Id })"
                                           class="text-primary hover:text-blue-700 transition-colors"
                                           title="عرض التفاصيل">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="@Url.Action("Edit","BranchManagement",new { id = branch.Id })"
                                           class="text-yellow-600 hover:text-yellow-700 transition-colors"
                                           title="تعديل الفرع">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button onclick="confirmDelete(@branch.Id, '@branch.Name')"
                                                class="text-red-600 hover:text-red-700 transition-colors"
                                                title="حذف الفرع">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <!-- في حال عدم وجود فروع -->
            <div class="text-center py-12 px-6">
                <div class="bg-gray-100 rounded-full p-3 w-16 h-16 mx-auto mb-4 flex items-center justify-center">
                    <i class="fas fa-code-branch text-gray-400 text-2xl"></i>
                </div>
                <h3 class="text-lg font-medium text-gray-900 mb-2">لا توجد فروع</h3>
                <p class="text-gray-500 mb-6">ابدأ بإنشاء موقع فرعك الأول.</p>
                <a href="@Url.Action("Create", "BranchManagement")"
                   class="inline-flex items-center px-4 py-2 bg-primary text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
                    <i class="fas fa-plus mr-2"></i>
                    إنشاء فرع جديد
                </a>
            </div>
        }
    </div>
</div>

<!-- التذييل -->
<footer class="text-center py-6 text-sm text-gray-500">
    © 2025 لوحة التحكم. جميع الحقوق محفوظة. الإصدار 1.0.0
</footer>

<script>
    function confirmDelete(id, name) {
        if (confirm(`هل أنت متأكد من حذف الفرع "${name}"؟ لا يمكن التراجع عن هذا الإجراء.`)) {
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("Delete","BranchManagement")/' + id;

            var token = document.createElement('input');
            token.type = 'hidden';
            token.name = '__RequestVerificationToken';
            token.value = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            form.appendChild(token);

            document.body.appendChild(form);
            form.submit();
        }
    }
</script>
