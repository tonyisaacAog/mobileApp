@using CompanyApi.DTOs.CompanyDtos
@model CompanyDto

@{
    ViewData["Title"] = "حذف الشركة";
    Layout = "_Layout";
}

<div class="p-6" dir="rtl">
    <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 text-right">
            <div class="mb-6">
                <h1 class="text-2xl font-bold text-gray-900 mb-2">حذف الشركة</h1>
                <p class="text-gray-600">هل أنت متأكد من حذف هذه الشركة؟ لا يمكن التراجع عن هذا الإجراء.</p>
            </div>

            <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
                <div class="flex items-start">
                    <div class="bg-red-100 rounded-full p-2 ml-3">
                        <i class="fas fa-exclamation-triangle text-red-600"></i>
                    </div>
                    <div>
                        <h3 class="font-medium text-red-900 mb-1">تحذير</h3>
                        <p class="text-red-700 text-sm">سيتم حذف هذه الشركة بشكل دائم من النظام. لا يمكن التراجع عن هذا الإجراء.</p>
                    </div>
                </div>
            </div>

            <div class="bg-gray-50 rounded-lg p-4 mb-6">
                <h3 class="font-medium text-gray-900 mb-3">معلومات الشركة</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">اسم الشركة</label>
                        <p class="text-gray-900">@Model.Name</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">الاسم التجاري</label>
                        <p class="text-gray-900">@(string.IsNullOrEmpty(Model.TradeName) ? "غير محدد" : Model.TradeName)</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">الرقم الضريبي</label>
                        <p class="text-gray-900">@Model.TaxNumber</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">الحالة</label>
                        <p class="text-gray-900">@(Model.IsActive ? "نشطة" : "غير نشطة")</p>
                    </div>
                </div>

                <div class="mt-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">العنوان</label>
                    <p class="text-gray-900">@Model.Address</p>
                </div>

                <div class="mt-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">البريد الإلكتروني</label>
                    <p class="text-gray-900">@(string.IsNullOrEmpty(Model.Email) ? "غير محدد" : Model.Email)</p>
                </div>

                <div class="mt-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">الهاتف</label>
                    <p class="text-gray-900">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "غير محدد" : Model.PhoneNumber)</p>
                </div>
            </div>

            <form asp-action="DeleteConfirmed" method="post" class="flex justify-between items-center">
                <input type="hidden" asp-for="Id" />
                <a href="@Url.Action("Index", "CompanyManagement")" class="px-4 py-2 text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                    <i class="fas fa-arrow-right mr-2"></i>إلغاء
                </a>
                <button type="submit" class="px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">
                    <i class="fas fa-trash mr-2"></i>حذف الشركة
                </button>
            </form>
        </div>
    </div>
</div>
