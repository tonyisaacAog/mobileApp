@using CompanyApi.DTOs.DeviceDtos
@model DeviceDto

@{
    ViewData["Title"] = "تفاصيل الجهاز";
    Layout = "_Layout";
}

<div class="p-6" dir="rtl">
    <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <div class="flex justify-between items-start mb-6">
                <div>
                    <h1 class="text-2xl font-bold text-gray-900 mb-2">تفاصيل الجهاز</h1>
                    <p class="text-gray-600">عرض معلومات الجهاز والمواصفات.</p>
                </div>
                <div class="flex space-x-2 rtl:space-x-reverse">
                    <a href="@Url.Action("Edit", "DeviceManagement", new { id = Model.Id })"
                       class="px-4 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 transition-colors">
                        <i class="fas fa-edit mr-2"></i>تعديل
                    </a>
                    <a href="@Url.Action("Index", "DeviceManagement")"
                       class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors">
                        <i class="fas fa-arrow-right mr-2"></i>العودة للقائمة
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">اسم الجهاز</label>
                        <p class="text-gray-900 bg-gray-50 px-3 py-2 rounded-lg">@Model.Name</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">رمز الجهاز</label>
                        <p class="text-gray-900 bg-gray-50 px-3 py-2 rounded-lg">@Model.Code</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">الرقم التسلسلي</label>
                        <p class="text-gray-900 bg-gray-50 px-3 py-2 rounded-lg">@Model.Serial</p>
                    </div>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">الطراز</label>
                        <p class="text-gray-900 bg-gray-50 px-3 py-2 rounded-lg">@Model.Model</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">نظام التشغيل</label>
                        <p class="text-gray-900 bg-gray-50 px-3 py-2 rounded-lg">@Model.OS</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">معرف الفرع</label>
                        <p class="text-gray-900 bg-gray-50 px-3 py-2 rounded-lg">@Model.BranchId</p>
                    </div>
                </div>
            </div>

            <div class="mt-8 pt-6 border-t border-gray-200">
                <div class="flex justify-between items-center">
                    <span class="text-sm text-gray-500">
                        معرف الجهاز: @Model.Id
                    </span>
                    <button onclick="confirmDelete(@Model.Id, '@Model.Name')"
                            class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">
                        <i class="fas fa-trash mr-2"></i>حذف الجهاز
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function confirmDelete(id, name) {
    if (confirm(`هل أنت متأكد من حذف الجهاز "${name}"؟ لا يمكن التراجع عن هذا الإجراء.`)) {
        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '@Url.Action("Delete", "DeviceManagement")/' + id;

        var token = document.createElement('input');
        token.type = 'hidden';
        token.name = '__RequestVerificationToken';
        token.value = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        form.appendChild(token);

        document.body.appendChild(form);
        form.submit();
    }
}
</script>
