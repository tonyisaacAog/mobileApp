@model CompanyApi.DTOs.DeviceDto

@{
    ViewData["Title"] = "Edit Device";
    Layout = "_Layout";
}

<div class="p-6">
    <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <div class="mb-6">
                <h1 class="text-2xl font-bold text-gray-900 mb-2">Edit Device</h1>
                <p class="text-gray-600">Update device information and settings.</p>
            </div>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="@Model.Id" />

                <div class="mb-4">
                    <label asp-for="@Model.Name" class="block text-sm font-medium text-gray-700 mb-2">Device Name</label>
                    <input asp-for="@Model.Name" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" required />
                    <span asp-validation-for="@Model.Name" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="@Model.Code" class="block text-sm font-medium text-gray-700 mb-2">Device Code</label>
                    <input asp-for="@Model.Code" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" required />
                    <span asp-validation-for="@Model.Code" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="@Model.Serial" class="block text-sm font-medium text-gray-700 mb-2">Serial Number</label>
                    <input asp-for="@Model.Serial" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" required />
                    <span asp-validation-for="@Model.Serial" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="@Model.Model" class="block text-sm font-medium text-gray-700 mb-2">Model</label>
                    <input asp-for="@Model.Model" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" required />
                    <span asp-validation-for="@Model.Model" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="@Model.OS" class="block text-sm font-medium text-gray-700 mb-2">Operating System</label>
                    <input asp-for="@Model.OS" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" required />
                    <span asp-validation-for="@Model.OS" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="@Model.BranchId" class="block text-sm font-medium text-gray-700 mb-2">Branch ID</label>
                    <input asp-for="@Model.BranchId" type="number" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" required />
                    <span asp-validation-for="@Model.BranchId" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div class="flex justify-between items-center pt-6">
                    <a href="@Url.Action("Index", "DeviceManagement")" class="px-4 py-2 text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                        <i class="fas fa-arrow-left mr-2"></i>Back to List
                    </a>
                    <button type="submit" class="px-6 py-2 bg-primary text-white rounded-lg hover:bg-blue-700 transition-colors">
                        <i class="fas fa-save mr-2"></i>Update Device
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
