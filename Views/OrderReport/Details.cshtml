@using CompanyApi.DTOs.OrderReportDtos
@model OrderDetailsDto

@{
    ViewData["Title"] = "تفاصيل الطلب";
    Layout = "_Layout";
}

<div class="p-6" dir="rtl">
    <!-- Header -->
    <div class="flex justify-between items-start mb-6">
        <div>
            <h1 class="text-2xl font-bold text-gray-900 mb-2">تفاصيل الطلب</h1>
            <p class="text-gray-600">عرض تفاصيل الطلب ورقم الإيصال: @Model.ReceiptNumber</p>
        </div>
        <div class="flex gap-2">
            <a href="@Url.Action("Index", "OrderReport")" class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors">
                <i class="fas fa-arrow-right ml-2"></i>العودة للتقرير
            </a>
            <a href="@Url.Action("Print", "OrderReport", new { id = Model.Id })" target="_blank"
               class="px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">
                <i class="fas fa-print ml-2"></i>طباعة الإيصال
            </a>
        </div>
    </div>

    <!-- Order Details Card -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Order Information -->
            <div class="space-y-4">
                <h3 class="text-lg font-semibold text-gray-900 border-b border-gray-200 pb-2">معلومات الطلب</h3>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">رقم الإيصال</label>
                        <p class="text-gray-900 font-medium">@Model.ReceiptNumber</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">تاريخ الإيصال</label>
                        <p class="text-gray-900">@Model.ReceiptDate.ToString("yyyy-MM-dd HH:mm")</p>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700">العميل</label>
                    <p class="text-gray-900">@Model.CustomerName</p>
                    @if (!string.IsNullOrEmpty(Model.CustomerPhone))
                    {
                        <p class="text-sm text-gray-600">@Model.CustomerPhone</p>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.CustomerAddress))
                {
                    <div>
                        <label class="block text-sm font-medium text-gray-700">العنوان</label>
                        <p class="text-gray-900">@Model.CustomerAddress</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.CustomerTaxId))
                {
                    <div>
                        <label class="block text-sm font-medium text-gray-700">الرقم الضريبي</label>
                        <p class="text-gray-900">@Model.CustomerTaxId</p>
                    </div>
                }
            </div>

            <!-- System Information -->
            <div class="space-y-4">
                <h3 class="text-lg font-semibold text-gray-900 border-b border-gray-200 pb-2">معلومات النظام</h3>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">الجهاز</label>
                        <p class="text-gray-900">@Model.DeviceName</p>
                        <p class="text-sm text-gray-600">@Model.DeviceCode</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">المستخدم</label>
                        <p class="text-gray-900">@Model.UserName</p>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700">الفرع</label>
                        <p class="text-gray-900">@Model.BranchName</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700">الشركة</label>
                        <p class="text-gray-900">@Model.CompanyName</p>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700">طريقة الدفع</label>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-sm font-medium
                        @(Model.PaymentMethod == "Cash" ? "bg-green-100 text-green-800" :
                          Model.PaymentMethod == "Card" ? "bg-blue-100 text-blue-800" :
                          "bg-gray-100 text-gray-800")">
                        @Model.PaymentMethod
                    </span>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="mt-6">
                <label class="block text-sm font-medium text-gray-700 mb-2">ملاحظات</label>
                <p class="text-gray-900 bg-gray-50 p-3 rounded-lg">@Model.Notes</p>
            </div>
        }
    </div>

    <!-- Order Items -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
        <h3 class="text-lg font-semibold text-gray-900 border-b border-gray-200 pb-2 mb-4">عناصر الطلب</h3>

        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                            المنتج
                        </th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                            الكمية
                        </th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                            سعر الوحدة
                        </th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                            الخصم
                        </th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                            الإجمالي
                        </th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="px-6 py-4">
                                <div class="text-sm font-medium text-gray-900">@item.ProductName</div>
                                @if (!string.IsNullOrEmpty(item.ProductCode))
                                {
                                    <div class="text-sm text-gray-500">@item.ProductCode</div>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                @item.Quantity
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                @item.UnitPrice.ToString("C")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                @item.Discount.ToString("C")
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                @item.TotalPrice.ToString("C")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Order Summary -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <h3 class="text-lg font-semibold text-gray-900 border-b border-gray-200 pb-2 mb-4">ملخص الطلب</h3>

        <div class="space-y-2 max-w-md ml-auto rtl:ml-auto rtl:ml-0">
            <div class="flex justify-between">
                <span class="text-gray-600">المجموع الفرعي:</span>
                <span class="font-medium">@Model.Subtotal.ToString("C")</span>
            </div>

            @if (Model.TotalDiscount > 0)
            {
                <div class="flex justify-between text-green-600">
                    <span>إجمالي الخصم:</span>
                    <span class="font-medium">-@Model.TotalDiscount.ToString("C")</span>
                </div>
            }

            @if (Model.ExtraDiscount > 0)
            {
                <div class="flex justify-between text-green-600">
                    <span>خصم إضافي:</span>
                    <span class="font-medium">-@Model.ExtraDiscount.ToString("C")</span>
                </div>
            }

            @if (Model.TaxAmount > 0)
            {
                <div class="flex justify-between">
                    <span class="text-gray-600">الضريبة:</span>
                    <span class="font-medium">@Model.TaxAmount.ToString("C")</span>
                </div>
            }

            @if (Model.TotalVAT > 0)
            {
                <div class="flex justify-between">
                    <span class="text-gray-600">ضريبة القيمة المضافة:</span>
                    <span class="font-medium">@Model.TotalVAT.ToString("C")</span>
                </div>
            }

            <div class="border-t border-gray-200 pt-2">
                <div class="flex justify-between text-lg font-bold text-gray-900">
                    <span>الإجمالي:</span>
                    <span>@Model.TotalAmount.ToString("C")</span>
                </div>
            </div>
        </div>
    </div>
</div>
