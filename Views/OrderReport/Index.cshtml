@using CompanyApi.DTOs.OrderReportDtos
@model OrderReportViewDto

@{
    ViewData["Title"] = "تقرير الطلبات";
    Layout = "_Layout";
}

<div class="p-6" dir="rtl">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">تقرير الطلبات</h1>
            <p class="text-gray-600 mt-1">عرض وتصفية الطلبات حسب التاريخ والجهاز والمستخدم</p>
        </div>
        <div class="flex gap-2">
            <a href="@Url.Action("Index", "Admin")" class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors">
                <i class="fas fa-arrow-right mr-2"></i>العودة للوحة التحكم
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
        <form asp-action="Index" method="get" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <!-- Date From -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">من تاريخ</label>
                    <input type="date" name="DateFrom" value="@(Model.Filter.DateFrom?.ToString("yyyy-MM-dd"))"
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" />
                </div>

                <!-- Date To -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">إلى تاريخ</label>
                    <input type="date" name="DateTo" value="@(Model.Filter.DateTo?.ToString("yyyy-MM-dd"))"
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" />
                </div>

                <!-- Device Code -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">رمز الجهاز</label>
                    <input type="text" name="DeviceCode" value="@Model.Filter.DeviceCode" placeholder="أدخل رمز الجهاز"
                           class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" />
                </div>

                <!-- User -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">المستخدم</label>
                    <select name="UserId" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent">
                        <option value="">اختر المستخدم</option>
                        @if (ViewBag.Users != null)
                        {
                            foreach (var user in ViewBag.Users as IEnumerable<SelectListItem>)
                            {
                                <option value="@user.Value" selected="@(Model.Filter.UserId?.ToString() == user.Value ? "selected" : null)">@user.Text</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="flex justify-center">
                <button type="submit" class="px-6 py-2 bg-primary text-white rounded-lg hover:bg-blue-700 transition-colors">
                    <i class="fas fa-search mr-2"></i>تصفية النتائج
                </button>
            </div>
        </form>
    </div>

    <!-- Results Summary -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 mb-6">
        <div class="flex justify-between items-center">
            <span class="text-sm text-gray-600">
                إجمالي الطلبات: <span class="font-bold text-primary">@Model.TotalCount</span>
            </span>
            @if (Model.Filter.PageNumber > 1 || Model.HasNextPage)
            {
                <div class="flex items-center space-x-2 rtl:space-x-reverse">
                    @if (Model.HasPreviousPage)
                    {
                        <a href="@Url.Action("Index", new {
                            DateFrom = Model.Filter.DateFrom?.ToString("yyyy-MM-dd"),
                            DateTo = Model.Filter.DateTo?.ToString("yyyy-MM-dd"),
                            DeviceCode = Model.Filter.DeviceCode,
                            UserId = Model.Filter.UserId,
                            PageNumber = Model.Filter.PageNumber - 1,
                            PageSize = Model.Filter.PageSize
                        })" class="px-3 py-1 text-sm bg-gray-200 text-gray-700 rounded hover:bg-gray-300">
                            السابق
                        </a>
                    }

                    <span class="text-sm text-gray-600">
                        صفحة @Model.Filter.PageNumber من @Model.TotalPages
                    </span>

                    @if (Model.HasNextPage)
                    {
                        <a href="@Url.Action("Index", new {
                            DateFrom = Model.Filter.DateFrom?.ToString("yyyy-MM-dd"),
                            DateTo = Model.Filter.DateTo?.ToString("yyyy-MM-dd"),
                            DeviceCode = Model.Filter.DeviceCode,
                            UserId = Model.Filter.UserId,
                            PageNumber = Model.Filter.PageNumber + 1,
                            PageSize = Model.Filter.PageSize
                        })" class="px-3 py-1 text-sm bg-gray-200 text-gray-700 rounded hover:bg-gray-300">
                            التالي
                        </a>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Orders Table -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        @if (Model.Orders.Any())
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                                رقم الإيصال
                            </th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                                التاريخ
                            </th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                                اسم العميل
                            </th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                                المبلغ الإجمالي
                            </th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                                طريقة الدفع
                            </th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                                الجهاز
                            </th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                                المستخدم
                            </th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                                الفرع
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                الإجراءات
                            </th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach (var order in Model.Orders)
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm font-medium text-gray-900">@order.ReceiptNumber</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-900">@order.ReceiptDate.ToString("yyyy-MM-dd HH:mm")</div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="text-sm text-gray-900">@order.CustomerName</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="text-sm text-gray-900">@order.TotalAmount.ToString("C")</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                        @(order.PaymentMethod == "Cash" ? "bg-green-100 text-green-800" :
                                          order.PaymentMethod == "Card" ? "bg-blue-100 text-blue-800" :
                                          "bg-gray-100 text-gray-800")">
                                        @order.PaymentMethod
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="text-sm text-gray-900">@order.DeviceName</div>
                                    <div class="text-sm text-gray-500">@order.DeviceCode</div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="text-sm text-gray-900">@order.UserName</div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="text-sm text-gray-900">@order.BranchName</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-left text-sm font-medium">
                                    <div class="flex items-center justify-start space-x-2 rtl:space-x-reverse">
                                        <a href="@Url.Action("Details", "OrderReport", new { id = order.Id })"
                                           class="text-primary hover:text-blue-700 transition-colors" title="عرض التفاصيل">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="@Url.Action("Print", "OrderReport", new { id = order.Id })"
                                           class="text-green-600 hover:text-green-700 transition-colors" title="طباعة الإيصال" target="_blank">
                                            <i class="fas fa-print"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-12 px-6">
                <div class="bg-gray-100 rounded-full p-3 w-16 h-16 mx-auto mb-4 flex items-center justify-center">
                    <i class="fas fa-receipt text-gray-400 text-2xl"></i>
                </div>
                <h3 class="text-lg font-medium text-gray-900 mb-2">لا توجد طلبات</h3>
                <p class="text-gray-500 mb-6">لم يتم العثور على طلبات تطابق معايير البحث المحددة.</p>
                <button onclick="document.querySelector('form').reset(); document.querySelector('form').submit();"
                        class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-blue-700 transition-colors">
                    <i class="fas fa-redo mr-2"></i>إعادة تعيين المرشحات
                </button>
            </div>
        }
    </div>
</div>
