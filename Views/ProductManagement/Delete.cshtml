@using CompanyApi.DTOs.ProductDtos
@model ProductDto

@{
    ViewData["Title"] = "حذف المنتج";
    Layout = "_Layout";
}

<div class="p-6" dir="rtl">
    <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <div class="mb-6 text-right">
                <h1 class="text-2xl font-bold text-gray-900 mb-2">حذف المنتج</h1>
                <p class="text-gray-600">هل أنت متأكد أنك تريد حذف هذا المنتج؟ لا يمكن التراجع عن هذا الإجراء.</p>
            </div>

            <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
                <div class="flex items-start">
                    <div class="bg-red-100 rounded-full p-2 ml-3">
                        <i class="fas fa-exclamation-triangle text-red-600"></i>
                    </div>
                    <div class="text-right">
                        <h3 class="font-medium text-red-900 mb-1">تحذير</h3>
                        <p class="text-red-700 text-sm">
                            حذف هذا المنتج سيؤدي إلى إزالته نهائيًا من النظام، ولا يمكن استرجاعه بعد ذلك.
                        </p>
                    </div>
                </div>
            </div>

            <div class="bg-gray-50 rounded-lg p-4 mb-6 text-right">
                <h3 class="font-medium text-gray-900 mb-3">معلومات المنتج</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">اسم المنتج</label>
                        <p class="text-gray-900">@Model.Name</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">رمز المنتج (SKU)</label>
                        <p class="text-gray-900">@Model.SKU</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">السعر</label>
                        <p class="text-gray-900">@Model.Price.ToString("C")</p>
                    </div>
                </div>

                <div class="mt-4">
                    <label class="block text-sm font-medium text-gray-700 mb-1">الفئة</label>
                    <p class="text-gray-900">@Model.Category</p>
                </div>
            </div>

            <form asp-action="DeleteConfirmed" method="post" class="flex justify-between items-center">
                <input type="hidden" asp-for="Id" />
                <a href="@Url.Action("Index","ProductManagement")"
                   class="px-4 py-2 text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                    <i class="fas fa-arrow-right ml-2"></i>إلغاء
                </a>
                <button type="submit"
                        class="px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">
                    <i class="fas fa-trash ml-2"></i>حذف المنتج
                </button>
            </form>
        </div>
    </div>
</div>
