@using CompanyApi.DTOs.ProductDtos
@model ProductDto

@{
    ViewData["Title"] = "تفاصيل المنتج";
    Layout = "_Layout";
}

<div class="p-6" dir="rtl">
    <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <div class="flex justify-between items-start mb-6">
                <div class="text-right">
                    <h1 class="text-2xl font-bold text-gray-900 mb-2">تفاصيل المنتج</h1>
                    <p class="text-gray-600">عرض معلومات ومواصفات المنتج.</p>
                </div>
                <div class="flex space-x-2 space-x-reverse">
                    <a href="@Url.Action("Edit","ProductManagement",new { id = Model.Id })"
                       class="px-4 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 transition-colors ml-2">
                        <i class="fas fa-edit ml-2"></i>تعديل
                    </a>
                    <a href="@Url.Action("Index","ProductManagement")"
                       class="px-4 py-2 bg-gray-600 text-white rounded-lg hover:bg-gray-700 transition-colors">
                        <i class="fas fa-arrow-right ml-2"></i>العودة للقائمة
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">اسم المنتج</label>
                        <p class="text-gray-900 bg-gray-50 px-3 py-2 rounded-lg">@Model.Name</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">رمز المنتج (SKU)</label>
                        <p class="text-gray-900 bg-gray-50 px-3 py-2 rounded-lg">@Model.SKU</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">الفئة</label>
                        <p class="text-gray-900 bg-gray-50 px-3 py-2 rounded-lg">@Model.Category</p>
                    </div>
                </div>

                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">السعر</label>
                        <p class="text-gray-900 bg-gray-50 px-3 py-2 rounded-lg">@Model.Price.ToString("C")</p>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">التكلفة</label>
                        <p class="text-gray-900 bg-gray-50 px-3 py-2 rounded-lg">@Model.Cost.ToString("C")</p>
                    </div>
                </div>
            </div>

            <div class="mt-6 text-right">
                <label class="block text-sm font-medium text-gray-700 mb-1">الوصف</label>
                <p class="text-gray-900 bg-gray-50 px-3 py-3 rounded-lg">
                    @(string.IsNullOrEmpty(Model.Description) ? "لا يوجد وصف متاح" : Model.Description)
                </p>
            </div>

            <div class="mt-8 pt-6 border-t border-gray-200">
                <div class="flex justify-between items-center">
                    <div class="flex items-center space-x-4 space-x-reverse text-sm text-gray-500">
                        <span>معرّف المنتج: @Model.Id</span>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @(Model.IsActive ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800")">
                            @(Model.IsActive ? "نشط" : "غير نشط")
                        </span>
                    </div>
                    <button onclick="confirmDelete(@Model.Id, '@Model.Name')"
                            class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">
                        <i class="fas fa-trash ml-2"></i>حذف المنتج
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function confirmDelete(id, name) {
        if (confirm(`هل أنت متأكد أنك تريد حذف المنتج "${name}"؟ لا يمكن التراجع عن هذا الإجراء.`)) {
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '@Url.Action("Delete","ProductManagement")/' + id;

            var token = document.createElement('input');
            token.type = 'hidden';
            token.name = '__RequestVerificationToken';
            token.value = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            form.appendChild(token);

            document.body.appendChild(form);
            form.submit();
        }
    }
</script>
