@using CompanyApi.DTOs.ProductDtos
@model ProductDto

@{
    ViewData["Title"] = "تعديل المنتج";
    Layout = "_Layout";
}

<div class="p-6" dir="rtl">
    <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <div class="mb-6">
                <h1 class="text-2xl font-bold text-gray-900 mb-2">تعديل المنتج</h1>
                <p class="text-gray-600">تحديث معلومات المنتج والمخزون.</p>
            </div>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="mb-4">
                    <label asp-for="Name" class="block text-sm font-medium text-gray-700 mb-2">اسم المنتج</label>
                    <input asp-for="Name" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" required />
                    <span asp-validation-for="Name" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="block text-sm font-medium text-gray-700 mb-2">الوصف</label>
                    <textarea asp-for="Description" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent"></textarea>
                    <span asp-validation-for="Description" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label asp-for="Price" class="block text-sm font-medium text-gray-700 mb-2">السعر</label>
                        <input asp-for="Price" type="number" step="0.01" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" required />
                        <span asp-validation-for="Price" class="text-red-500 text-sm mt-1"></span>
                    </div>

                    <div>
                        <label asp-for="Cost" class="block text-sm font-medium text-gray-700 mb-2">التكلفة</label>
                        <input asp-for="Cost" type="number" step="0.01" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" required />
                        <span asp-validation-for="Cost" class="text-red-500 text-sm mt-1"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label asp-for="SKU" class="block text-sm font-medium text-gray-700 mb-2">رمز المنتج</label>
                        <input asp-for="SKU" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" required />
                        <span asp-validation-for="SKU" class="text-red-500 text-sm mt-1"></span>
                    </div>

                    <div>
                        <label asp-for="Category" class="block text-sm font-medium text-gray-700 mb-2">الفئة</label>
                        <input asp-for="Category" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" required />
                        <span asp-validation-for="Category" class="text-red-500 text-sm mt-1"></span>
                    </div>
                </div>


                <div class="mb-4">
                    <div class="flex items-center">
                        <input asp-for="IsActive" type="checkbox" class="h-4 w-4 text-primary focus:ring-primary border-gray-300 rounded" />
                        <label asp-for="IsActive" class="mr-2 block text-sm text-gray-900">نشط</label>
                    </div>
                    <span asp-validation-for="IsActive" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div class="mb-4">
                    <div class="flex items-center">
                        <input asp-for="IsTaxable" type="checkbox" class="h-4 w-4 text-primary focus:ring-primary border-gray-300 rounded" />
                        <label asp-for="IsTaxable" class="mr-2 block text-sm text-gray-900">خاضع للضريبة</label>
                    </div>
                    <span asp-validation-for="IsTaxable" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div class="flex justify-between items-center pt-6">
                    <a href="@Url.Action("Index", "ProductManagement")" class="px-4 py-2 text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                        <i class="fas fa-arrow-right mr-2"></i>العودة للقائمة
                    </a>
                    <button type="submit" class="px-6 py-2 bg-primary text-white rounded-lg hover:bg-blue-700 transition-colors">
                        <i class="fas fa-save mr-2"></i>تحديث المنتج
                    </button>
                </div>
            </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
