@using CompanyApi.DTOs.ProductDtos
@model List<ProductDto>

@{
    ViewData["Title"] = "إدارة المنتجات";
    Layout = "_Layout";
}

<div class="p-6" dir="rtl">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-4">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">إدارة المنتجات</h1>
            <p class="text-gray-600 mt-1">إدارة كتالوج المنتجات والمخزون</p>
        </div>
        <a href="@Url.Action("Create","ProductManagement")"
           class="inline-flex items-center px-4 py-2 bg-primary text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
            <i class="fas fa-plus ml-2"></i>
            إضافة منتج جديد
        </a>
    </div>

    <!-- الجدول -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        @if( Model.Any() )
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                                تفاصيل المنتج
                            </th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                                التسعير
                            </th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                                المخزون
                            </th>
                            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                                الحالة
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                الإجراءات
                            </th>
                            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                                الإجراءات
                            </th>
                        </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                        @foreach( var product in Model )
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4">
                                    <div class="flex items-center">
                                        <div class="bg-orange-100 rounded-full p-2 ml-3">
                                            <i class="fas fa-box text-orange-600"></i>
                                        </div>
                                        <div class="text-right">
                                            <div class="text-sm font-medium text-gray-900">@product.Name</div>
                                            <div class="text-sm text-gray-500">@product.Category</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="text-sm text-gray-900">@product.Price.ToString("C")</div>
                                    <div class="text-sm text-gray-500">التكلفة: @product.Cost.ToString("C")</div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="text-sm text-gray-500">رمز المنتج: @product.SKU</div>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-right">
                                    @if( product.IsActive )
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                            <i class="fas fa-check-circle ml-1"></i>
                                            نشط
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                            <i class="fas fa-pause-circle ml-2"></i>
                                            غير نشط
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-left text-sm font-medium">
                                    <div class="flex items-center justify-start space-x-2 rtl:space-x-reverse">
                                        <a href="@Url.Action("Details", "ProductManagement", new { id = product.Id })"
                                           class="text-primary hover:text-blue-700 transition-colors ml-2">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="@Url.Action("Edit","ProductManagement",new { id = product.Id })"
                                           class="text-yellow-600 hover:text-yellow-700 transition-colors">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="@Url.Action("Delete", "ProductManagement", new { id = product.Id })"
                                           class="text-red-600 hover:text-red-700 transition-colors">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                      @*   <button onclick="confirmDelete(@product.Id, '@product.Name')"
                                                class="text-red-600 hover:text-red-700 transition-colors">
                                            <i class="fas fa-trash"></i>
                                        </button> *@
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-12 px-6">
                <div class="bg-gray-100 rounded-full p-3 w-16 h-16 mx-auto mb-4 flex items-center justify-center">
                    <i class="fas fa-box text-gray-400 text-2xl"></i>
                </div>
                <h3 class="text-lg font-medium text-gray-900 mb-2">لا توجد منتجات</h3>
                <p class="text-gray-500 mb-6">ابدأ بإضافة منتجك الأول إلى الكتالوج.</p>
                <a href="@Url.Action("Create", "ProductManagement")"
                   class="inline-flex items-center px-4 py-2 bg-primary text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition-colors">
                    <i class="fas fa-plus ml-2"></i>
                    إنشاء منتج جديد
                </a>
            </div>
        }
    </div>
</div>

<script>
function confirmDelete(id, name) {
    if (confirm(`هل أنت متأكد من حذف المنتج "${name}"؟`)) {
        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '@Url.Action("Delete", "ProductManagement")/' + id;
        var token = document.createElement('input');
        token.type = 'hidden';
        token.name = '__RequestVerificationToken';
        token.value = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        form.appendChild(token);
        document.body.appendChild(form);
        form.submit();
    }
}
</script>
