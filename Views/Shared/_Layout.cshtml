<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - لوحة التحكم</title>

    <!-- HTML5 Arabic Fonts -->
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.gstatic.com/ar/Jomhuri/css2/v14/JomhuriJn_6qfj30c5Wg.ttf" as="font" crossorigin>
    <!-- Tailwind CSS via CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#3B82F6',
                        secondary: '#10B981',
                        danger: '#EF4444',
                        warning: '#F59E0B',
                        info: '#06B6D4',
                    }
                }
            }
        }
    </script>

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- External CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tailwindcss-rtl@2.6.0/dist/tailwind-rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* Comprehensive RTL Support */
        [dir="rtl"] {
            direction: rtl;
        }

        /* Icon positioning fixes */
        [dir="rtl"] .fas,
        [dir="rtl"] .fa,
        [dir="rtl"] .far {
            transform: scaleX(-1);
        }

        /* Fix specific icon issues */
        [dir="rtl"] .fa-chevron-down,
        [dir="rtl"] .fa-chevron-up,
        [dir="rtl"] .fa-chevron-left,
        [dir="rtl"] .fa-chevron-right,
        [dir="rtl"] .fa-arrow-left,
        [dir="rtl"] .fa-arrow-right,
        [dir="rtl"] .fa-angle-left,
        [dir="rtl"] .fa-angle-right {
            transform: scaleX(-1);
        }

        /* Margin and padding fixes */
        [dir="rtl"] .rtl-mr-2 { margin-right: 0.5rem; margin-left: 0 !important; }
        [dir="rtl"] .rtl-ml-2 { margin-left: 0.5rem; margin-right: 0 !important; }
        [dir="rtl"] .rtl-mr-1 { margin-right: 0.25rem; margin-left: 0 !important; }
        [dir="rtl"] .rtl-ml-1 { margin-left: 0.25rem; margin-right: 0 !important; }
        [dir="rtl"] .rtl-mr-3 { margin-right: 0.75rem; margin-left: 0 !important; }
        [dir="rtl"] .rtl-ml-3 { margin-left: 0.75rem; margin-right: 0 !important; }
        [dir="rtl"] .rtl-mr-4 { margin-right: 1rem; margin-left: 0 !important; }
        [dir="rtl"] .rtl-ml-4 { margin-left: 1rem; margin-right: 0 !important; }

        /* Space between fixes */
        [dir="rtl"] .rtl\:space-x-reverse > :not([hidden]) ~ :not([hidden]) {
            margin-right: calc(0.5rem * calc(1 - var(--tw-space-x-reverse)));
            margin-left: calc(0.5rem * var(--tw-space-x-reverse));
        }

        /* Text alignment */
        [dir="rtl"] .rtl\:text-right { text-align: right; }
        [dir="rtl"] .rtl\:text-left { text-align: left; }

        /* Flex direction fixes */
        [dir="rtl"] .rtl\:flex-row-reverse { flex-direction: row-reverse; }
        [dir="rtl"] .rtl\:justify-start { justify-content: flex-start; }
        [dir="rtl"] .rtl\:justify-end { justify-content: flex-end; }

        /* Table fixes */
        [dir="rtl"] table { direction: rtl; }
        [dir="rtl"] th { text-align: right; }
        [dir="rtl"] td { text-align: right; }

        /* Form elements */
        [dir="rtl"] input[type="text"],
        [dir="rtl"] input[type="email"],
        [dir="rtl"] input[type="password"],
        [dir="rtl"] input[type="number"],
        [dir="rtl"] textarea,
        [dir="rtl"] select {
            direction: rtl;
            text-align: right;
        }

        /* Dropdown and menu positioning */
        [dir="rtl"] .dropdown-menu {
            right: 0;
            left: auto;
        }

        [dir="rtl"] .dropdown-menu.dropdown-menu-right {
            right: auto;
            left: 0;
        }

        /* Button group fixes */
        [dir="rtl"] .btn-group .btn:not(:first-child):not(:last-child) {
            border-radius: 0;
        }

        [dir="rtl"] .btn-group .btn:first-child {
            border-top-right-radius: 0.375rem;
            border-bottom-right-radius: 0.375rem;
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
        }

        [dir="rtl"] .btn-group .btn:last-child {
            border-top-left-radius: 0.375rem;
            border-bottom-left-radius: 0.375rem;
            border-top-right-radius: 0;
            border-bottom-right-radius: 0;
        }

        /* Modal fixes */
        [dir="rtl"] .modal-header .close {
            margin-left: auto;
            margin-right: -1rem;
        }

        /* Alert dismiss button */
        [dir="rtl"] .alert .btn-close {
            margin-left: auto;
        }

        /* Navigation fixes */
        [dir="rtl"] .navbar-nav {
            margin-right: 0;
            margin-left: auto;
        }

        [dir="rtl"] .navbar-nav .nav-item {
            float: right;
        }

        /* Card fixes */
        [dir="rtl"] .card-header {
            text-align: right;
        }

        /* Badge and label fixes */
        [dir="rtl"] .badge {
            direction: ltr;
        }

        /* Progress bar fixes */
        [dir="rtl"] .progress-bar {
            direction: ltr;
        }

        /* Tooltip fixes */
        [dir="rtl"] .tooltip {
            text-align: right;
        }

        /* Custom scrollbar for RTL */
        [dir="rtl"] ::-webkit-scrollbar {
            width: 8px;
        }

        [dir="rtl"] ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        [dir="rtl"] ::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 4px;
        }

        [dir="rtl"] ::-webkit-scrollbar-thumb:hover {
            background: #555;
        }

        /* Mobile menu specific fixes */
        [dir="rtl"] #mobile-menu {
            direction: rtl;
        }

        [dir="rtl"] .mobile-menu-button {
            direction: ltr;
        }

        /* Flash message fixes */
        [dir="rtl"] .alert-auto-hide {
            direction: rtl;
        }

        [dir="rtl"] .dismiss-alert {
            margin-left: auto;
            margin-right: 0;
        }
    </style>
</head>
<body class="bg-gray-50 min-h-screen">
    <!-- Navigation -->
    <nav class="bg-white shadow-sm border-b border-gray-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <!-- Logo -->
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <h1 class="text-xl font-bold text-gray-900">لوحة التحكم</h1>
                    </div>
                </div>

                <!-- Desktop Navigation -->
                <div class="hidden md:block">
                    <div class="ml-10 flex items-baseline space-x-4 rtl:space-x-reverse">
                        <a href="@Url.Action("Index", "Admin")"
                           class="px-3 py-2 rounded-md text-sm font-medium @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "bg-primary text-white" : "text-gray-700 hover:bg-gray-100")">
                            <i class="fas fa-tachometer-alt ml-2 rtl:mr-2 rtl:ml-0"></i>الرئيسية
                        </a>

                        <div class="relative group">
                            <button class="px-3 py-2 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-100 flex items-center rtl:flex-row-reverse">
                                <i class="fas fa-cog mr-2 rtl:ml-2 rtl:mr-0"></i>الإدارة
                                <i class="fas fa-chevron-down ml-1 rtl:mr-1 rtl:ml-0 text-xs"></i>
                            </button>

                            <!-- Dropdown Menu -->
                            <div class="absolute right-0 rtl:right-auto rtl:left-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-50 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200">
                                <a href="@Url.Action("Index", "BranchManagement")" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 rtl:text-right">
                                    <i class="fas fa-code-branch mr-2 rtl:ml-2 rtl:mr-0"></i>الفروع
                                </a>
                                <a href="@Url.Action("Index", "UserManagement")" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 rtl:text-right">
                                    <i class="fas fa-users mr-2 rtl:ml-2 rtl:mr-0"></i>المستخدمين
                                </a>
                                <a href="@Url.Action("Index", "CompanyManagement")" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 rtl:text-right">
                                    <i class="fas fa-building mr-2 rtl:ml-2 rtl:mr-0"></i>الشركات
                                </a>
                                <a href="@Url.Action("Index", "DeviceManagement")" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 rtl:text-right">
                                    <i class="fas fa-mobile-alt mr-2 rtl:ml-2 rtl:mr-0"></i>الأجهزة
                                </a>
                                <a href="@Url.Action("Index", "ProductManagement")" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 rtl:text-right">
                                    <i class="fas fa-box mr-2 rtl:ml-2 rtl:mr-0"></i>المنتجات
                                </a>
                                <a href="@Url.Action("Index", "OrderReport")" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 rtl:text-right">
                                    <i class="fas fa-chart-bar mr-2 rtl:ml-2 rtl:mr-0"></i>تقرير الطلبات
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- User Menu -->
                <div class="hidden md:block">
                    <div class="ml-4 flex items-center md:ml-6 rtl:mr-4 rtl:ml-0">
                        <button class="bg-primary text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700 transition-colors rtl:flex-row-reverse">
                            <i class="fas fa-sign-out-alt mr-2 rtl:ml-2 rtl:mr-0"></i>تسجيل الخروج
                        </button>
                    </div>
                </div>

                <!-- Mobile menu button -->
                <div class="md:hidden">
                    <button type="button"
                            class="mobile-menu-button bg-gray-100 inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-primary"
                            aria-controls="mobile-menu"
                            aria-expanded="false">
                        <i class="fas fa-bars"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="mobile-menu hidden md:hidden">
            <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3 bg-white border-t border-gray-200">
                <a href="@Url.Action("Index", "Admin")" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-gray-100 rtl:text-right">
                    <i class="fas fa-tachometer-alt mr-2 rtl:ml-2 rtl:mr-0"></i>الرئيسية
                </a>
                <a href="@Url.Action("Index", "BranchManagement")" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-gray-100 rtl:text-right">
                    <i class="fas fa-code-branch mr-2 rtl:ml-2 rtl:mr-0"></i>الفروع
                </a>
                <a href="@Url.Action("Index", "UserManagement")" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-gray-100 rtl:text-right">
                    <i class="fas fa-users mr-2 rtl:ml-2 rtl:mr-0"></i>المستخدمين
                </a>
                <a href="@Url.Action("Index", "CompanyManagement")" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-gray-100 rtl:text-right">
                    <i class="fas fa-building mr-2 rtl:ml-2 rtl:mr-0"></i>الشركات
                </a>
                <a href="@Url.Action("Index", "DeviceManagement")" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-gray-100 rtl:text-right">
                    <i class="fas fa-mobile-alt mr-2 rtl:ml-2 rtl:mr-0"></i>الأجهزة
                </a>
                <a href="@Url.Action("Index", "ProductManagement")" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-gray-100 rtl:text-right">
                    <i class="fas fa-box mr-2 rtl:ml-2 rtl:mr-0"></i>المنتجات
                </a>
                <a href="@Url.Action("Index", "OrderReport")" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:bg-gray-100 rtl:text-right">
                    <i class="fas fa-chart-bar mr-2 rtl:ml-2 rtl:mr-0"></i>تقرير الطلبات
                </a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        <!-- Flash Messages -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-4 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg flex items-center alert-auto-hide rtl:flex-row-reverse">
                <i class="fas fa-check-circle mr-2 rtl:ml-2 rtl:mr-0"></i>
                @TempData["SuccessMessage"]
                <button type="button" class="ml-auto rtl:mr-auto rtl:ml-0 text-green-500 hover:text-green-700 dismiss-alert">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-4 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg flex items-center alert-auto-hide rtl:flex-row-reverse">
                <i class="fas fa-exclamation-circle mr-2 rtl:ml-2 rtl:mr-0"></i>
                @TempData["ErrorMessage"]
                <button type="button" class="ml-auto rtl:mr-auto rtl:ml-0 text-red-500 hover:text-red-700 dismiss-alert">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        }

        <!-- Page Content -->
        <div class="bg-white rounded-lg shadow-sm">
            @RenderBody()
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-200 mt-12">
        <div class="max-w-7xl mx-auto py-4 px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center rtl:flex-row-reverse">
                <p class="text-sm text-gray-500">&copy; 2025 لوحة التحكم. جميع الحقوق محفوظة.</p>
                <div class="flex space-x-4 rtl:space-x-reverse">
                    <span class="text-sm text-gray-400">الإصدار 1.0.0</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        // Mobile menu toggle with accessibility
        $('.mobile-menu-button').on('click', function () {
            $('#mobile-menu').toggleClass('hidden');
            const expanded = $(this).attr('aria-expanded') === 'true';
            $(this).attr('aria-expanded', !expanded);
        });

        // Dismiss alerts
        $('.dismiss-alert').on('click', function () {
            $(this).parent().fadeOut();
        });

        // Auto-hide alerts after 5 seconds
        setTimeout(() => {
            $('.alert-auto-hide').fadeOut();
        }, 5000);

        // Smooth scrolling for RTL
        $('a[href^="#"]').on('click', function (event) {
            var target = $($(this).attr('href'));
            if (target.length) {
                event.preventDefault();
                $('html, body').animate({
                    scrollTop: target.offset().top - 100
                }, 500);
            }
        });

        // RTL-specific fixes for jQuery animations and effects
        if ($('html').attr('dir') === 'rtl') {
            // Fix for jQuery slide animations in RTL
            $.fn.extend({
                slideDownRTL: function() {
                    return this.each(function() {
                        $(this).show('slide', { direction: 'right' }, 300);
                    });
                },
                slideUpRTL: function() {
                    return this.each(function() {
                        $(this).hide('slide', { direction: 'right' }, 300);
                    });
                }
            });
        }

        // Add loading state to forms
        $('form').on('submit', function () {
            $(this).find('button[type="submit"]')
                .prop('disabled', true)
                .html('<i class="fas fa-spinner fa-spin mr-2 rtl:ml-2 rtl:mr-0"></i>جاري المعالجة...');
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>