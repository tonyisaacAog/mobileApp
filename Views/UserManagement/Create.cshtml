@model CompanyApi.DTOs.UserDtos.CreateUserDto

@{

    ViewData["Title"] = "إنشاء مستخدم جديد";
    Layout = "_Layout";

    var data = Model;
}

<div class="p-6" dir="rtl">
    <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <div class="mb-6">
                <h1 class="text-2xl font-bold text-gray-900 mb-2">إنشاء مستخدم جديد</h1>
                <p class="text-gray-600">إضافة حساب مستخدم جديد إلى النظام.</p>
            </div>

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="mb-4">
                    <label asp-for="Username" class="block text-sm font-medium text-gray-700 mb-2">اسم المستخدم</label>
                    <input asp-for="Username" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" required />
                    <span asp-validation-for="Username" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-2">البريد الإلكتروني</label>
                    <input asp-for="Email" type="email" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" required />
                    <span asp-validation-for="Email" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label asp-for="FirstName" class="block text-sm font-medium text-gray-700 mb-2">الاسم الأول</label>
                        <input asp-for="FirstName" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" required />
                        <span asp-validation-for="FirstName" class="text-red-500 text-sm mt-1"></span>
                    </div>

                    <div>
                        <label asp-for="LastName" class="block text-sm font-medium text-gray-700 mb-2">الاسم الأخير</label>
                        <input asp-for="LastName" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" required />
                        <span asp-validation-for="LastName" class="text-red-500 text-sm mt-1"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="PhoneNumber" class="block text-sm font-medium text-gray-700 mb-2">رقم الهاتف</label>
                    <input asp-for="PhoneNumber" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" />
                    <span asp-validation-for="PhoneNumber" class="text-red-500 text-sm mt-1"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-2">كلمة المرور</label>
                    <input asp-for="Password" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary focus:border-transparent" />
                    <span asp-validation-for="Password" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div class="mb-4">
                    <div class="flex items-center">
                        <input asp-for="IsAdmin" type="checkbox" class="h-4 w-4 text-primary focus:ring-primary border-gray-300 rounded" />
                        <label asp-for="IsAdmin" class="mr-2 block text-sm text-gray-900">مدير</label>
                    </div>
                    <span asp-validation-for="IsAdmin" class="text-red-500 text-sm mt-1"></span>
                </div>

                <div class="flex justify-between items-center pt-6">
                    <a href="@Url.Action("Index", "UserManagement")" class="px-4 py-2 text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                        <i class="fas fa-arrow-right mr-2"></i>العودة للقائمة
                    </a>
                    <button type="submit" class="px-6 py-2 bg-primary text-white rounded-lg hover:bg-blue-700 transition-colors">
                        <i class="fas fa-save mr-2"></i>إنشاء المستخدم
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
