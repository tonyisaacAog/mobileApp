@model CompanyApi.DTOs.UserDtos.UserDto

@{
    ViewData["Title"] = "Delete User";
    Layout = "_Layout";
}

<div class="p-6">
    <div class="max-w-2xl mx-auto">
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <div class="mb-6">
                <h1 class="text-2xl font-bold text-gray-900 mb-2">Delete User</h1>
                <p class="text-gray-600">Are you sure you want to delete this user account? This action cannot be undone.</p>
            </div>

            <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
                <div class="flex items-start">
                    <div class="bg-red-100 rounded-full p-2 mr-3">
                        <i class="fas fa-exclamation-triangle text-red-600"></i>
                    </div>
                    <div>
                        <h3 class="font-medium text-red-900 mb-1">Warning</h3>
                        <p class="text-red-700 text-sm">Deleting this user account will permanently remove it from the system. This action cannot be reversed.</p>
                    </div>
                </div>
            </div>

            <div class="bg-gray-50 rounded-lg p-4 mb-6">
                <h3 class="font-medium text-gray-900 mb-3">User Information</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Username</label>
                        <p class="text-gray-900">@Model.Username</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                        <p class="text-gray-900">@Model.Email</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                        <p class="text-gray-900">@Model.FirstName @Model.LastName</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Phone</label>
                        <p class="text-gray-900">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not specified" : Model.PhoneNumber)</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Status</label>
                        <p class="text-gray-900">@(Model.IsActive ? "Active" : "Inactive")</p>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Role</label>
                        <p class="text-gray-900">@(Model.IsAdmin ? "Administrator" : "User")</p>
                    </div>
                </div>
            </div>

         @*    <form asp-action="DeleteConfirmed" method="post" class="flex justify-between items-center">
                <input type="hidden" asp-for="Id" />
                <a href="@Url.Action("Index", "UserManagement")" class="px-4 py-2 text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                    <i class="fas fa-arrow-left mr-2"></i>Cancel
                </a>
                <button type="submit" class="px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">
                    <i class="fas fa-trash mr-2"></i>Delete User
                </button>
            </form> *@
        </div>
    </div>
</div>
