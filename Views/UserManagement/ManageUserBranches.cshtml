@using CompanyApi.DTOs.UserDtos
@model CompanyApi.DTOs.UserDtos.UserDto

@{
    ViewData["Title"] = "إدارة فروع المستخدم";
    Layout = "_Layout";

    var user = ViewBag.User as UserDto;
    var allBranches = ViewBag.AllBranches as IEnumerable<CompanyApi.DTOs.BranchDtos.BranchDto>;
}

<div class="p-6" dir="rtl">
    <!-- Header -->
    <div class="mb-6">
        <div class="flex items-center mb-4">
            <a href="@Url.Action("Index","UserManagement")" class="text-primary hover:text-blue-700 mr-2">
                <i class="fas fa-arrow-right"></i>
            </a>
            <h1 class="text-2xl font-bold text-gray-900">إدارة فروع المستخدم</h1>
        </div>

        <!-- User Info Card -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 mb-6">
            <div class="flex items-center">
                <div class="bg-blue-100 rounded-full p-3 mr-4">
                    <i class="fas fa-user text-blue-600 text-xl"></i>
                </div>
                <div>
                    <h2 class="text-lg font-semibold text-gray-900">@user.FirstName @user.LastName</h2>
                    <p class="text-gray-600">@user.Username - @user.Email</p>
                </div>
                <div class="mr-auto">
                    @if( user.IsAdmin )
                    {
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-purple-100 text-purple-800">
                            <i class="fas fa-crown mr-1"></i> مدير
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-blue-100 text-blue-800">
                            <i class="fas fa-user mr-1"></i> مستخدم
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Branches Management -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <h2 class="text-xl font-semibold text-gray-900 mb-4 flex items-center">
            <i class="fas fa-code-branch mr-2 text-primary"></i>
            الفروع المتاحة للمستخدم
        </h2>

        @if( allBranches != null && allBranches.Any() )
        {
            <form asp-action="AssignBranches" method="post">
                <input type="hidden" name="userId" value="@user.Id" />

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    @foreach( var branch in allBranches )
                    {
                        <div class="border border-gray-200 rounded-lg p-4 hover:shadow-md transition-shadow">
                            <div class="flex items-start">
                                <div class="bg-green-100 rounded-lg p-2 mr-3">
                                    <i class="fas fa-map-marker-alt text-green-600"></i>
                                </div>
                                <div class="flex-1">
                                    <h3 class="font-medium text-gray-900">@branch.Name</h3>
                                    <p class="text-sm text-gray-500">@branch.Code</p>
                                </div>
                            </div>

                            <div class="mt-3">
                                <label class="flex items-center">
                                    <input type="checkbox"
                                           name="SelectedBranches"
                                           value="@branch.Id"
                                           class="h-4 w-4 text-primary focus:ring-primary border-gray-300 rounded"
                                           @(branch.IsActive ? "checked" : "") />
                                    <span class="mr-2 text-sm text-gray-700">
                                        @(branch.IsActive ? "نشط" : "غير نشط")
                                    </span>
                                </label>
                            </div>
                        </div>
                    }
                </div>

                <div class="flex justify-between items-center mt-6 pt-6 border-t border-gray-200">
                    <a href="@Url.Action("Index","UserManagement")"
                       class="px-4 py-2 text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
                        <i class="fas fa-arrow-right mr-2"></i>العودة لقائمة المستخدمين
                    </a>

                    <button type="submit" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-blue-700 transition-colors">
                        <i class="fas fa-save mr-2"></i>حفظ التغييرات
                    </button>
                </div>
            </form>

        }
        else
        {
            <!-- Empty State -->
            <div class="text-center py-12 px-6">
                <div class="bg-gray-100 rounded-full p-3 w-16 h-16 mx-auto mb-4 flex items-center justify-center">
                    <i class="fas fa-code-branch text-gray-400 text-2xl"></i>
                </div>
                <h3 class="text-lg font-medium text-gray-900 mb-2">لا توجد فروع متاحة</h3>
                <p class="text-gray-500">قم بإنشاء فروع جديدة أولاً لتتمكن من إدارة صلاحيات المستخدمين.</p>
            </div>
        }
    </div>

    <!-- Action Buttons -->
    <@* div class="flex justify-between items-center mt-6 pt-6 border-t border-gray-200">
        <a href="@Url.Action("Index","UserManagement")"
           class="px-4 py-2 text-gray-700 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors">
            <i class="fas fa-arrow-right mr-2"></i>العودة لقائمة المستخدمين
        </a>

        <div class="flex space-x-3 rtl:space-x-reverse">
            <button class="px-4 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600 transition-colors">
                <i class="fas fa-save mr-2"></i>حفظ التغييرات
            </button>
        </div>
    </div> *@
</div>

@section Scripts {
    <script>
        // Add any JavaScript functionality for branch management here
        console.log('User Branch Management loaded');
    </script>
}
